{
  "schema_version": "1.1.0",
  "library_id": "trader-thoughts",
  "title": "Trader Thoughts — Биржевой караул",
  "language": "ru-RU",
  "description": "Short, disjointed, irritated and increasingly unhinged Russian thoughts for gaps in a fictional trading terminal log.",
  "style": {
    "voice": "unreliable trader; alternating rambling and furious internal voices",
    "register": "post-Soviet retail trading slang, claustrophobia, repetition, profanity, tangents and sudden irritation",
    "reference": "https://ru.wikiquote.org/wiki/Зелёный_слоник",
    "original_text_only": true,
    "profanity_levels": {"0": "clean", "1": "mild", "2": "strong"},
    "rendering": "Display as THOUGHT, never as an actual user action or exchange event."
  },
  "event_vocabulary": [
    "market.open", "market.switch", "instrument.select", "instrument.search", "search.clear",
    "chart.zoom_in", "chart.zoom_out", "chart.pan", "chart.timeframe_change",
    "book.open", "book.scroll", "order.ticket_open", "order.side_select", "order.quantity_edit",
    "order.price_edit", "order.submit", "order.accepted", "order.filled", "order.partial_fill",
    "order.cancel_request", "order.canceled", "order.rejected", "position.open",
    "position.close", "popup.open", "popup.read", "popup.dismiss", "warning.open",
    "balance.view", "portfolio.view", "history.open", "watchlist.edit", "ui.scroll",
    "ui.idle", "ui.hover", "connection.lag", "session.end"
  ],
  "placement_contract": {
    "after_any": "The immediately preceding logged UI event must be one of these; [] means unrestricted.",
    "before_any": "The next logged UI event must be one of these; [] means unrestricted. Lookahead is optional only when this array is empty.",
    "gap_ms": "Inclusive eligible pause duration; null max means no upper bound.",
    "delay_ms": "Suggested insertion delay after preceding event; clamp to actual gap.",
    "cooldown_events": "Minimum number of real UI events before the same thought may recur.",
    "weight": "Relative selection weight among simultaneously eligible entries; not probability.",
    "context": "Optional predicates supplied by the engine; if unavailable, skip the entry rather than assume a value.",
    "fallback": "Entries marked fallback may fill gaps where no specific event pair matches."
  },
  "defaults": {
    "gap_ms": {"min": 1400, "max": 15000},
    "delay_ms": 700,
    "weight": 1,
    "cooldown_events": 20,
    "max_thoughts_per_gap": 1,
    "dedupe_window": 12,
    "profanity_ceiling": 2
  },
  "thoughts": [
    {"id":"TT001","class":"market_recon","after_any":["market.open","market.switch"],"before_any":["instrument.select","instrument.search"],"text":"Ну, биржа открылась. И чё? Сидим теперь, да?","tags":["rank","order_book"],"profanity":0},
    {"id":"TT002","class":"market_recon","after_any":["market.switch"],"before_any":[],"text":"Туда зайду… Не, сюда. Да какая нахуй разница.","tags":["market","barracks"],"profanity":2},
    {"id":"TT003","class":"market_recon","after_any":["instrument.select"],"before_any":["chart.zoom_in","book.open","order.ticket_open"],"text":"О, вот она. Смотри, чё с ней. Видишь? А я нет.","tags":["chart","rank"],"profanity":0},
    {"id":"TT004","class":"market_recon","after_any":["instrument.select"],"before_any":[],"text":"Знаю я эту бумагу. Было с ней… Не помню, короче.","tags":["ticker","school"],"profanity":0},
    {"id":"TT005","class":"market_recon","after_any":["watchlist.edit"],"before_any":[],"text":"Пускай тут висит. Может, пригодится. Хотя нахуй она мне.","tags":["watchlist","authority"],"profanity":2},
    {"id":"TT006","class":"search_delirium","after_any":["instrument.search"],"before_any":["instrument.select","search.clear"],"text":"Газпром… Где он, блядь? Только что был.","tags":["search","blue_chip"],"profanity":2},
    {"id":"TT007","class":"search_delirium","after_any":["instrument.search"],"before_any":[],"text":"Да ты посмотри, сколько их. Я одну ищу, одну!","tags":["search","crowd"],"profanity":0},
    {"id":"TT008","class":"search_delirium","after_any":["search.clear"],"before_any":["instrument.search"],"text":"Убрал. Не надо мне это всё. Сейчас заново.","tags":["search","bureaucracy"],"profanity":0},
    {"id":"TT009","class":"search_delirium","after_any":["instrument.search"],"before_any":["ui.idle"],"text":"Была такая, понимаешь, акция… хорошая. Бля, как называлась?","tags":["forgetfulness","dividend"],"profanity":0},
    {"id":"TT010","class":"chart_divination","after_any":["chart.zoom_in"],"before_any":["chart.zoom_in","chart.pan"],"text":"Поближе давай. Ещё. Чё-то там маленькое шевелится.","tags":["candles","repetition"],"profanity":0},
    {"id":"TT011","class":"chart_divination","after_any":["chart.zoom_in"],"before_any":[],"text":"Вот этот хвост видишь? Бля, ну вот этот!","tags":["wick","rank"],"profanity":0},
    {"id":"TT012","class":"chart_divination","after_any":["chart.zoom_out"],"before_any":[],"text":"Отошёл подальше — вроде нормально. А было-то говно.","tags":["timeframe","debt"],"profanity":0},
    {"id":"TT013","class":"chart_divination","after_any":["chart.pan"],"before_any":["chart.zoom_in","chart.timeframe_change"],"text":"Тут я покупал. Вот тут. Ой, бля. Не надо туда.","tags":["margin","rank"],"profanity":0},
    {"id":"TT014","class":"chart_divination","after_any":["chart.timeframe_change"],"before_any":[],"text":"На минутках одно, на днях другое. Ты чё несёшь вообще?","tags":["timeframe","conflict"],"profanity":0},
    {"id":"TT015","class":"chart_divination","after_any":["chart.zoom_in","chart.pan"],"before_any":["order.ticket_open"],"text":"Сейчас линию проведу. Вот так. Нормально? Ну и всё.","tags":["analysis","1998"],"profanity":0},
    {"id":"TT016","class":"chart_divination","after_any":["chart.zoom_in"],"before_any":["chart.zoom_out"],"text":"Красная опять. Да заебала ты уже, честное слово.","tags":["candles","absurd"],"profanity":2},
    {"id":"TT017","class":"chart_divination","after_any":["chart.timeframe_change"],"before_any":["chart.pan"],"text":"А раньше-то росла. Я помню. Или не эта.","tags":["trend","leverage"],"profanity":0},
    {"id":"TT018","class":"book_hallucination","after_any":["book.open"],"before_any":["book.scroll","order.ticket_open"],"text":"Стакан. Смотри, сколько народу. Чего все хотят-то?","tags":["order_book","spread"],"profanity":0},
    {"id":"TT019","class":"book_hallucination","after_any":["book.scroll"],"before_any":[],"text":"Вниз листаю, а они всё стоят. Суки, терпеливые.","tags":["liquidity","barracks"],"profanity":0},
    {"id":"TT020","class":"book_hallucination","after_any":["book.open"],"before_any":[],"text":"Вот кто столько наставил? Ты что, охуел, что ли?","tags":["sell_wall","rank"],"profanity":2},
    {"id":"TT021","class":"book_hallucination","after_any":["book.scroll"],"before_any":["order.price_edit"],"text":"По копейке, блядь. Туда-сюда. Ну чё ты дрочишься?","tags":["ticks","queue"],"profanity":2},
    {"id":"TT022","class":"ticket_anxiety","after_any":["order.ticket_open"],"before_any":["order.side_select","order.quantity_edit"],"text":"Так. Купить. Или продать? Подожди, не трогай.","tags":["ticket","rank"],"profanity":0},
    {"id":"TT023","class":"ticket_anxiety","after_any":["order.side_select"],"before_any":["order.quantity_edit","order.price_edit"],"text":"Возьму, наверное. Да возьму, чё тут думать.","tags":["buy","ownership"],"profanity":0},
    {"id":"TT024","class":"ticket_anxiety","after_any":["order.quantity_edit"],"before_any":["order.submit"],"text":"Сколько? Десять?.. Не, три. Три давай.","tags":["lot","position_sizing"],"profanity":0},
    {"id":"TT025","class":"ticket_anxiety","after_any":["order.price_edit"],"before_any":["order.submit"],"text":"Вот сюда цену. Не, ниже. Чуть-чуть, ёпта.","tags":["limit_order","bureaucracy"],"profanity":0},
    {"id":"TT026","class":"ticket_anxiety","after_any":["order.quantity_edit"],"before_any":["order.quantity_edit"],"text":"Сколько я написал? Бля. Нолик откуда взялся?","tags":["quantity","panic"],"profanity":0},
    {"id":"TT027","class":"ticket_anxiety","after_any":["order.price_edit"],"before_any":["order.price_edit"],"text":"Ну красивая цена. Мне нравится. А ему нет.","tags":["price","parade"],"profanity":0},
    {"id":"TT028","class":"pre_submit","after_any":["order.quantity_edit","order.price_edit"],"before_any":["order.submit"],"text":"Нажать, что ли? Подожди. Сейчас, блядь, нажму.","tags":["submit","risk"],"profanity":2,"gap_ms":{"min":1800,"max":12000}},
    {"id":"TT029","class":"pre_submit","after_any":["order.side_select"],"before_any":["order.submit"],"text":"Пускай идёт. Я сказал — купить. Слышишь?","tags":["orders","authority"],"profanity":0},
    {"id":"TT030","class":"order_wait","after_any":["order.submit","order.accepted"],"before_any":["order.filled","order.partial_fill","order.cancel_request"],"text":"Приняли. И чё теперь? Стоит, блядь, и стоит.","tags":["queue","bureaucracy"],"profanity":2},
    {"id":"TT031","class":"order_wait","after_any":["order.accepted"],"before_any":[],"text":"Братишка, ну исполнись ты. Ну что тебе надо?","tags":["order","personification"],"profanity":0},
    {"id":"TT032","class":"order_wait","after_any":["order.submit"],"before_any":["order.accepted"],"text":"Отправил. Куда оно ушло? Нихуя не понятно.","tags":["latency","barracks"],"profanity":2},
    {"id":"TT033","class":"order_wait","after_any":["order.accepted"],"before_any":["order.cancel_request"],"text":"Не, убрать надо. Убрать, говорю. Чё я наделал?","tags":["cancel","rank"],"profanity":0},
    {"id":"TT034","class":"fill_reaction","after_any":["order.filled"],"before_any":["position.open","portfolio.view","chart.zoom_in"],"text":"О! Взяли! Блядь, а я уже не хотел.","tags":["fill","parade"],"profanity":2},
    {"id":"TT035","class":"fill_reaction","after_any":["order.filled"],"before_any":[],"text":"Это моё теперь? Ну. Хорошо. А зачем?","tags":["fill","confusion"],"profanity":0},
    {"id":"TT036","class":"fill_reaction","after_any":["order.partial_fill"],"before_any":["order.filled","order.cancel_request"],"text":"Половину дали. А вторую кто съел, блядь?","tags":["partial_fill","discipline"],"profanity":2},
    {"id":"TT037","class":"fill_reaction","after_any":["order.filled"],"before_any":["balance.view"],"text":"Деньги списали. Вот суки. Хотя я ж сам нажал.","tags":["balance","accounting"],"profanity":0},
    {"id":"TT038","class":"cancel_regret","after_any":["order.cancel_request"],"before_any":["order.canceled"],"text":"Отмена, отмена. Да нажал я уже, слышишь?","tags":["cancel","command"],"profanity":0},
    {"id":"TT039","class":"cancel_regret","after_any":["order.canceled"],"before_any":[],"text":"Всё, убрали. А чего я тогда ждал?","tags":["cancel","economy"],"profanity":0},
    {"id":"TT040","class":"cancel_regret","after_any":["order.canceled"],"before_any":["order.ticket_open"],"text":"Сейчас обратно поставлю. Не смейся, блядь.","tags":["repeat","indecision"],"profanity":2},
    {"id":"TT041","class":"error_tribunal","after_any":["order.rejected"],"before_any":["popup.open","order.ticket_open"],"text":"Не принял. Ты чё, охуел? Я нормально нажал.","tags":["rejection","authority"],"profanity":2},
    {"id":"TT042","class":"error_tribunal","after_any":["order.rejected"],"before_any":[],"text":"Денег нет. Ну нет, и чё теперь орать-то?","tags":["insufficient_funds","bureaucracy"],"profanity":0},
    {"id":"TT043","class":"popup_interrogation","after_any":["popup.open","warning.open"],"before_any":["popup.read","popup.dismiss"],"text":"Что опять вылезло? Убери. Дай посмотреть.","tags":["popup","rank"],"profanity":0},
    {"id":"TT044","class":"popup_interrogation","after_any":["popup.read"],"before_any":["popup.dismiss"],"text":"Читаю, читаю. Да заткнись ты, я читаю!","tags":["confirmation","confusion"],"profanity":0},
    {"id":"TT045","class":"popup_interrogation","after_any":["warning.open"],"before_any":["popup.dismiss"],"text":"Про риски пишет. Бля, я их уже вижу.","tags":["risk_warning","1998"],"profanity":0},
    {"id":"TT046","class":"popup_interrogation","after_any":["popup.read"],"before_any":[],"text":"Тут три строчки… Нет, четыре. Чё они хотят?","tags":["legalese","bureaucracy"],"profanity":0},
    {"id":"TT047","class":"popup_interrogation","after_any":["popup.dismiss"],"before_any":[],"text":"Закрыл. Всё. Не понял нихуя, но закрыл.","tags":["dismiss","denial"],"profanity":2},
    {"id":"TT048","class":"portfolio_reckoning","after_any":["portfolio.view","balance.view"],"before_any":[],"text":"Смотри, сколько у меня всего. А толку-то.","tags":["portfolio","regret"],"profanity":0},
    {"id":"TT049","class":"portfolio_reckoning","after_any":["balance.view"],"before_any":["order.ticket_open"],"text":"На один лот хватит. Наверное. Сейчас посчитаю.","tags":["balance","food"],"profanity":0},
    {"id":"TT050","class":"portfolio_reckoning","after_any":["position.open"],"before_any":["chart.zoom_in","position.close"],"text":"Открылась позиция. Ну вот. Теперь сидеть.","tags":["position","authority"],"profanity":0},
    {"id":"TT051","class":"portfolio_reckoning","after_any":["position.close"],"before_any":[],"text":"Закрыл. Всё, больше не буду. Сегодня.","tags":["close","commission"],"profanity":0},
    {"id":"TT052","class":"portfolio_reckoning","after_any":["history.open"],"before_any":[],"text":"Вот тут я зря. А тут… тоже зря, блядь.","tags":["history","bureaucracy"],"profanity":2},
    {"id":"TT053","class":"scrolling_fugue","after_any":["ui.scroll"],"before_any":["ui.scroll","ui.hover"],"text":"Куда оно делось? Я вниз кручу, оно опять тут.","tags":["scroll","absurd"],"profanity":0},
    {"id":"TT054","class":"scrolling_fugue","after_any":["ui.scroll","book.scroll"],"before_any":[],"text":"Цифры, цифры… Сука, глаза уже болят.","tags":["scroll","barracks"],"profanity":2},
    {"id":"TT055","class":"scrolling_fugue","after_any":["ui.hover"],"before_any":["popup.open","ui.scroll"],"text":"Тут что написано? А, подсказка. Да иди ты.","tags":["tooltip","self_deprecation"],"profanity":0},
    {"id":"TT056","class":"idle_soliloquy","after_any":["ui.idle"],"before_any":[],"text":"Сидим. Ничего не происходит. Ну и хорошо.","tags":["idle","debt"],"profanity":0,"fallback":true},
    {"id":"TT057","class":"idle_soliloquy","after_any":[],"before_any":[],"text":"Братишка… Слушай, я тебе про одну акцию расскажу.","tags":["philosophy","idle"],"profanity":0,"fallback":true,"gap_ms":{"min":5000,"max":null}},
    {"id":"TT058","class":"idle_soliloquy","after_any":[],"before_any":[],"text":"Чай бы сейчас. Только встать страшно, блядь.","tags":["tea","candles"],"profanity":2,"fallback":true,"gap_ms":{"min":4000,"max":null}},
    {"id":"TT059","class":"idle_soliloquy","after_any":["ui.idle","ui.hover"],"before_any":[],"text":"Я уже полчаса смотрю. Ты понимаешь? Полчаса!","tags":["capital","secrecy"],"profanity":0,"fallback":true},
    {"id":"TT060","class":"idle_soliloquy","after_any":[],"before_any":[],"text":"Вот раньше, помню… А, нет. Не помню.","tags":["chart","ritual"],"profanity":0,"fallback":true,"gap_ms":{"min":3500,"max":null}},
    {"id":"TT061","class":"connection_paranoia","after_any":["connection.lag"],"before_any":[],"text":"Зависло? Ну всё. Всё, блядь. Приехали.","tags":["latency","barracks"],"profanity":2},
    {"id":"TT062","class":"connection_paranoia","after_any":["connection.lag"],"before_any":["order.accepted","order.filled"],"text":"Крутится, сука. Ну крутись. Я подожду.","tags":["latency","bureaucracy"],"profanity":2},
    {"id":"TT063","class":"session_farewell","after_any":["session.end"],"before_any":[],"text":"Всё, хватит. Я домой хочу.","tags":["closing","barracks"],"profanity":0},
    {"id":"TT064","class":"session_farewell","after_any":["session.end"],"before_any":[],"text":"Завтра ещё зайду. Хотя нахуй. Зайду.","tags":["closing","rank"],"profanity":2}
  ]
}
